{
    "object": "Payment",
    "version": "1.0",
    "table": "payments",
    "description": "Pencatatan pembayaran dan bukti transfer. Fase utama hanya manual, tanpa payment gateway otomatis (Rule 12). Top client B2B mencatat identitas pengirim terpisah dari penerima (§15.3).",
    "fields": [
        { "name": "id", "type": "int", "required": true, "nullable": false },
        { "name": "invoice_id", "type": "int", "required": false, "nullable": true, "note": "Kosong untuk pembayaran di muka pesanan reguler." },
        { "name": "order_id", "type": "int", "required": false, "nullable": true },
        { "name": "client_id", "type": "int", "required": true, "nullable": false },
        { "name": "payment_provider", "type": "enum", "required": true, "nullable": false, "note": "Fase utama hanya manual." },
        { "name": "payment_method", "type": "enum", "required": true, "nullable": false },
        { "name": "transaction_id", "type": "string", "required": false, "nullable": true, "note": "Diisi manual dari bukti transfer." },
        { "name": "amount", "type": "int", "required": true, "nullable": false, "note": "Rupiah penuh." },
        { "name": "status", "type": "enum", "required": true, "nullable": false, "note": "menunggu_verifikasi wajib lewat verifikasi manual oleh sekre." },
        { "name": "proof_url", "type": "string", "required": false, "nullable": true, "note": "Bukti transfer yang diunggah klien." },
        { "name": "paid_at", "type": "datetime", "required": false, "nullable": true, "note": "Waktu bayar diklaim klien, bukan waktu verifikasi." },
        { "name": "verified_by", "type": "int", "required": false, "nullable": true, "note": "Admin atau sekre yang memverifikasi." },
        { "name": "verified_at", "type": "datetime", "required": false, "nullable": true },
        { "name": "verification_note", "type": "text", "required": false, "nullable": true },
        { "name": "created_at", "type": "datetime", "required": true, "nullable": false },
        { "name": "updated_at", "type": "datetime", "required": true, "nullable": false }
    ],
    "enums": {
        "payment_provider": ["manual", "provider_gateway"],
        "payment_method": ["transfer", "qris", "cod", "top", "ewallet", "virtual_account"],
        "status": ["belum_dibayar", "menunggu_verifikasi", "terverifikasi", "ditolak", "lunas"]
    },
    "relations": {
        "invoice": "Invoice | null",
        "order": "Order | null",
        "client": "User"
    },
