              "status": "Found",
              "code": 302
            }
          ]
        }
      ]
    },
    {
      "name": "04. Armada Logistik & PoD",
      "item": [
        {
          "name": "4.1 Konfirmasi Truk Berangkat (Mulai Rute)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/armada/surat-jalan/1/mulai",
              "host": ["{{baseUrl}}"],
              "path": ["armada", "surat-jalan", "1", "mulai"]
            },
            "description": "Driver armada mengonfirmasi keberangkatan dari gudang GPA, mencatat departure_time, dan memicu status DALAM_PENGIRIMAN."
          },
          "response": [
            {
              "name": "Armada Menuju Dock Klien",
              "status": "Found",
              "code": 302
            }
          ]
        },
        {
          "name": "4.2 Finalisasi Serah Terima Barang (PoD Selesai)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "manifest_photo",
                  "type": "file",
                  "src": "",
                  "description": "Foto timbangan berat netto sebelum muat"
                },
                {
                  "key": "dock_photo",
                  "type": "file",
                  "src": "",
                  "description": "Foto serah terima fisik di dermaga klien"
                },
                {
                  "key": "recipient_name",
                  "value": "Agus Triyono (Kepala Gudang Klien)",
                  "type": "text"
                },
                {
                  "key": "received_notes",
                  "value": "Seluruh sayuran diterima segar dalam kondisi prima.",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/armada/bukti-terima/1/selesai",
              "host": ["{{baseUrl}}"],
              "path": ["armada", "bukti-terima", "1", "selesai"]
            },
            "description": "Driver menyelesaikan pengiriman dengan mengunggah foto bukti serah terima (Proof of Delivery), mengunci arrival_time, dan mengubah status menjadi SELESAI."
          },
          "response": [
            {
              "name": "Pengiriman Berhasil Dituntaskan",
              "status": "Found",
              "code": 302
            }
          ]
        }
      ]
    },
    {
      "name": "05. Dokumen Cetak Format Resmi A4",
      "item": [
        {
          "name": "5.1 Cetak Surat Jalan Resmi (A4)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/print/surat-jalan?order_id=1",
              "host": ["{{baseUrl}}"],
              "path": ["print", "surat-jalan"],
              "query": [
                {
                  "key": "order_id",
                  "value": "1"
                }
              ]
            },
            "description": "Menampilkan lembar cetak Surat Jalan resmi format A4 dengan barcode/QR dan kolom tanda tangan supir serta penerima."
          },
          "response": [
            {
              "name": "Dokumen Surat Jalan",
              "status": "OK",
              "code": 200
            }
          ]
        },
        {
          "name": "5.2 Cetak Faktur Tagihan (Invoice A4)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/print/faktur/1",
              "host": ["{{baseUrl}}"],
              "path": ["print", "faktur", "1"]
            },
            "description": "Menampilkan dokumen cetak Faktur Pajak/Tagihan resmi dengan rincian subtotal, PPN, dan rekening kas GPA."
          },
          "response": [
            {
              "name": "Dokumen Faktur Terbit",
              "status": "OK",
              "code": 200
            }
          ]
        },
        {
          "name": "5.3 Cetak Struk Kasir Thermal (58mm/80mm)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/print/struk/1",
              "host": ["{{baseUrl}}"],
              "path": ["print", "struk", "1"]
            },
            "description": "Format struk kasir mini kompatibel printer bluetooth/POS thermal receipt."
          },
          "response": [
            {
              "name": "Struk Kasir Siap Cetak",
              "status": "OK",
              "code": 200
            }
          ]
        },
        {
          "name": "5.4 Cetak Berita Acara Retur Komoditas",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/print/berita-acara-retur?order_id=1",
              "host": ["{{baseUrl}}"],
              "path": ["print", "berita-acara-retur"],
              "query": [
                {
                  "key": "order_id",
                  "value": "1"
                }
              ]
            },
            "description": "Menampilkan lembar berita acara pengembalian sayuran retur yang rusak atau susut mutu."
          },
          "response": [
            {
              "name": "Berita Acara Retur",
              "status": "OK",
              "code": 200
            }
          ]
        }
      ]
    }
