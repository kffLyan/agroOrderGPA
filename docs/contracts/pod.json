{
    "object": "ProofOfDelivery",
    "version": "1.0",
    "table": "proof_of_deliveries",
    "description": "Bukti penerimaan di lokasi klien. Wajib lengkap sebelum delivery ditandai selesai (Rule 06). Setelah terkunci tidak dapat diedit.",
    "fields": [
        { "name": "id", "type": "int", "required": true, "nullable": false },
        { "name": "delivery_id", "type": "int", "required": true, "nullable": false },
        { "name": "surat_jalan_id", "type": "int", "required": true, "nullable": false },
        { "name": "receiver_name", "type": "string", "required": true, "nullable": false, "note": "Nama penerima di lokasi, boleh berbeda dari penerima kontrak." },
        { "name": "receiver_role", "type": "string", "required": false, "nullable": true, "note": "Contoh: Receiving." },
        { "name": "received_at", "type": "datetime", "required": true, "nullable": false },
        { "name": "signature_path", "type": "string", "required": true, "nullable": false, "note": "Path file tanda tangan digital." },
        { "name": "photo_paths", "type": "json", "required": false, "nullable": true, "note": "Daftar path foto kondisi barang di lokasi." },
        { "name": "geolocation", "type": "json", "required": false, "nullable": true, "note": "Object dengan latitude dan longitude." },
        { "name": "note", "type": "text", "required": false, "nullable": true },
        { "name": "submitted_by", "type": "int", "required": true, "nullable": false, "note": "Supir yang mengirim bukti." },
        { "name": "submitted_at", "type": "datetime", "required": true, "nullable": false },
        { "name": "locked_at", "type": "datetime", "required": false, "nullable": true }
    ],
    "relations": {
        "delivery": "Delivery",
        "surat_jalan": "SuratJalan"
    },
