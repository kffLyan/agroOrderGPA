            "description": "Sekretaris membatalkan pesanan PO dengan melampirkan alasan penolakan tertulis yang akan tampil di dashboard klien."
          },
          "response": [
            {
              "name": "Pesanan Berhasil Ditolak",
              "status": "Found",
              "code": 302
            }
          ]
        },
        {
          "name": "3.3 Verifikasi Pembayaran (Setujui)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/sekretaris/pembayaran/1/setujui",
              "host": ["{{baseUrl}}"],
              "path": ["sekretaris", "pembayaran", "1", "setujui"]
            },
            "description": "Sekretaris memverifikasi dana transfer telah masuk rekening kas koperasi GPA dan mengubah status menjadi LUNAS."
          },
          "response": [
            {
              "name": "Pembayaran Lunas",
              "status": "Found",
              "code": 302
            }
          ]
        },
        {
          "name": "3.4 Tolak Bukti Transfer Pembayaran",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "rejection_reason",
                  "value": "Foto struk transfer terpotong dan mutasi rekening belum terbaca.",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/sekretaris/pembayaran/1/tolak",
              "host": ["{{baseUrl}}"],
              "path": ["sekretaris", "pembayaran", "1", "tolak"]
            },
            "description": "Sekretaris menolak foto bukti pembayaran yang tidak sah atau buram."
          },
          "response": [
            {
              "name": "Bukti Ditolak",
              "status": "Found",
              "code": 302
            }
          ]
        },
