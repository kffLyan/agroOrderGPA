{
    "object": "Return",
    "version": "1.0",
    "table": "returns",
    "description": "Retur barang di lokasi klien setelah barang diterima. Retur memengaruhi invoice dan dapat memunculkan kompensasi kuota (§13).",
    "fields": [
        { "name": "id", "type": "int", "required": true, "nullable": false },
        { "name": "delivery_id", "type": "int", "required": true, "nullable": false },
        { "name": "order_item_id", "type": "int", "required": true, "nullable": false },
        { "name": "product_id", "type": "int", "required": true, "nullable": false },
        { "name": "quantity", "type": "decimal", "required": true, "nullable": false, "note": "Berat retur dalam kilogram." },
        { "name": "containers", "type": "int", "required": false, "nullable": true },
        { "name": "reason_code", "type": "enum", "required": true, "nullable": false },
        { "name": "note", "type": "text", "required": false, "nullable": true },
        { "name": "occurred_at", "type": "datetime", "required": true, "nullable": false, "note": "Waktu pencatatan retur oleh supir di lokasi." },
        { "name": "recorded_by", "type": "int", "required": true, "nullable": false },
        { "name": "compensation_id", "type": "int", "required": false, "nullable": true, "note": "Kompensasi yang dihasilkan, bila ada." }
    ],
    "enums": {
